{
  "name": "handova",
  "version": "1.1.0",
  "description": "Got more than one Claude Code or Codex account? Switch between them without logging out, hand a conversation and its memory to another when one hits its usage limit, and keep every account's profile clean.",
  "license": "MIT",
  "author": "Franklin Okolie (https://www.franklinokolie.com)",
  "homepage": "https://handova.franklinokolie.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeveloperAspire/handova.git"
  },
  "bugs": "https://github.com/DeveloperAspire/handova/issues",
  "type": "module",
  "bin": {
    "handova": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "claude",
    "claude-code",
    "accounts",
    "cli",
    "codex",
    "openai",
    "ai-agents"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --target node --outfile dist/cli.js",
    "compile": "bun build src/cli.ts --compile --outfile build/handova",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
