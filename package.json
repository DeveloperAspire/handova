{
  "name": "handova",
  "version": "1.0.0",
  "description": "Run Claude Code under several accounts, and hand a conversation over from one account to another.",
  "license": "MIT",
  "author": "Franklin Okolie (https://www.franklinokolie.com)",
  "homepage": "https://handova.franklinokolie.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeveloperAspire/handova.git"
  },
  "bugs": "https://github.com/DeveloperAspire/handova/issues",
  "type": "module",
  "bin": {
    "handova": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.16"
  },
  "keywords": [
    "claude",
    "claude-code",
    "accounts",
    "cli"
  ],
  "scripts": {
    "build": "bun build src/cli.ts --target node --outfile dist/cli.js",
    "compile": "bun build src/cli.ts --compile --outfile build/handova",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1"
  },
  "devDependencies": {
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
