---
// A terminal you can drive. It starts inside a Claude Code session that has just hit its usage limit; each button
// leaves the session, runs a real handova command and plays its output. The Claude Code screen follows the real app:
// welcome box, ⏺ tool calls with ⎿ results, and the input box. Demo data is made up (alex@mail.com, Lumen Studio).
const commands = [
  { id: "handoff", label: "handova handoff primary backup" },
  { id: "codex", label: "handova handoff codex codex-backup" },
  { id: "list", label: "handova list" },
  { id: "continue", label: "handova backup --continue" },
  { id: "primary", label: "handova primary" },
];
---

<div class="terminal-demo" data-terminal>
  <div class="overflow-hidden rounded-2xl border border-line-strong bg-surface shadow-[0_30px_80px_-30px_rgb(0_0_0/0.9)]">
    <div class="flex items-center gap-3 border-b border-line px-4 py-3">
      <div class="flex gap-1.5" aria-hidden="true">
        <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
        <span class="h-2.5 w-2.5 rounded-full bg-white/15"></span>
      </div>
      <span class="min-w-0 flex-1 truncate font-mono text-[0.72rem] text-muted">~/code/upload-service</span>
      <span class="account-chip flex items-center gap-1.5 rounded-[5px] border border-line bg-raised px-2 py-1 font-mono text-[0.7rem] text-ink-soft">
        <span class="h-1.5 w-1.5 rounded-full bg-active" aria-hidden="true"></span>
        <span class="hidden font-sans text-faint sm:inline" data-agent>Claude Code</span>
        <span class="sr-only">Active account:</span>
        <span data-active>primary</span>
      </span>
    </div>
    <div class="flex h-[22rem] flex-col font-mono text-[0.7rem] leading-[1.7] sm:h-[25rem] sm:text-[0.8rem]">
      <div class="terminal-body min-h-0 flex-1 overflow-y-auto overscroll-contain px-4 pt-4 sm:px-5" role="log" aria-label="Terminal output" data-output>
        <div class="line cc-box"><span class="spark" aria-hidden="true"></span>Welcome to <b>Claude Code</b>!<br /><span class="text-muted">cwd: /Users/alex/code/upload-service</span></div>
        <div class="line cc-user"><span class="text-muted">&gt;</span> Add rate limiting to the upload API</div>
        <div class="line"><span class="text-ink">⏺</span> I'll add rate limiting to the upload endpoint, starting with the handler.</div>
        <div class="line"><span class="text-muted">⏺</span> <b class="text-ink">Update</b><span class="text-ink-soft">(src/upload/handler.ts)</span></div>
        <div class="line result"><span class="elbow" aria-hidden="true"></span><span class="text-muted">Updated src/upload/handler.ts with 22 additions and 3 removals</span></div>
        <div class="line"><span class="text-muted">⏺</span> <b class="text-ink">Bash</b><span class="text-ink-soft">(npm test)</span></div>
        <div class="line result"><span class="elbow" aria-hidden="true"></span><b class="text-[#f28b82]">Claude usage limit reached. Your limit will reset at 4pm.</b></div>
      </div>
      <div class="px-3 pb-3 pt-2 sm:px-4" data-input>
        <div class="flex items-center rounded-[8px] border border-white/20 px-3 py-1.5">
          <span class="text-muted" data-input-prefix>&gt;</span>&nbsp;<span class="cursor" aria-hidden="true"></span>
        </div>
        <div class="mt-1 pl-3 text-[0.62rem] text-faint sm:text-[0.68rem]">? for shortcuts</div>
      </div>
    </div>
  </div>

  <div class="mt-5 flex flex-col items-center gap-1.5 text-center">
    <p class="flex items-center gap-2 text-[0.85rem] text-ink-soft">
      <span class="shrink-0 whitespace-nowrap rounded-full border border-line-strong bg-raised px-2 py-0.5 font-mono text-[0.68rem] uppercase tracking-[0.12em] text-ink">Try it</span>
      <span>Click a command to run it<span class="hidden sm:inline"> in the session above</span></span>
      <svg class="h-3.5 w-3.5 shrink-0 text-muted" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 3v10M4 9l4 4 4-4" /></svg>
    </p>
  </div>
  <div class="mt-3 flex flex-wrap justify-center gap-2" role="group" aria-label="Commands to try">
    {commands.map((command, i) => (
      <button
        type="button"
        class:list={[
          "press flex items-center gap-1.5 rounded-[5px] border px-3 py-1.5 font-mono text-[0.75rem]",
          i === 0 ? "first-run border-line-strong bg-white/[0.07] text-ink hover:bg-white/[0.12]" : "border-line text-ink-soft hover:border-line-strong hover:text-ink",
        ]}
        data-run={command.id}
      >
        <svg class="h-2.5 w-2.5 shrink-0 opacity-70" viewBox="0 0 10 10" fill="currentColor" aria-hidden="true"><path d="M2.5 1.6v6.8a.5.5 0 0 0 .76.43l5.3-3.4a.5.5 0 0 0 0-.86L3.26 1.17a.5.5 0 0 0-.76.43Z" /></svg>
        {command.label}
      </button>
    ))}
  </div>
  <p class="mt-3 text-center text-[0.8rem] text-faint">
    <span data-hint>Start with the first one: the session above just hit its usage limit.</span>
    <button type="button" class="hidden text-ink-soft underline decoration-line-strong underline-offset-4 transition-colors hover:text-ink" data-reset>
      ↺ Start over
    </button>
  </p>
</div>

<!-- Global, because the script adds lines that Astro's scoped styles wouldn't reach. -->
<style is:global>
  /* Long lines wrap with a hanging indent on narrow screens; tables scroll sideways instead. */
  [data-terminal] .line {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    padding-left: 2ch;
    text-indent: -2ch;
    animation: line-in 0.22s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  [data-terminal] .line.result {
    padding-left: 5ch;
    text-indent: -3ch;
  }
  [data-terminal] .line.dim {
    opacity: 0.5;
  }
  [data-terminal] .terminal-body {
    scrollbar-width: none;
  }
  [data-terminal] .line.term-table {
    white-space: pre;
    overflow-x: auto;
    padding-left: 0;
    text-indent: 0;
    scrollbar-width: none;
  }
  /* Claude Code's welcome box, and Codex's header box. */
  [data-terminal] .cc-box {
    display: inline-block;
    max-width: 100%;
    margin: 0 0 0.9em;
    padding: 0.45em 1em 0.45em 0.9em;
    border: 1.5px solid #d97757;
    border-radius: 8px;
    text-indent: 0;
    line-height: 1.8;
  }
  [data-terminal] .cc-box.codex {
    border-color: var(--color-line-strong);
  }
  /* The user's message, on a faint band like the real app. */
  [data-terminal] .cc-user {
    margin: 0 -0.5em 0.15em;
    padding-right: 0.5em;
    padding-left: calc(2ch + 0.5em);
    border-radius: 5px;
    background: rgb(255 255 255 / 0.05);
  }
  /* Glyphs Geist Mono doesn't have: Claude Code's spark and the ⎿ result elbow. */
  [data-terminal] .spark {
    position: relative;
    display: inline-block;
    width: 0.95em;
    height: 0.95em;
    margin-right: 0.55em;
    vertical-align: -0.12em;
    background:
      linear-gradient(#d97757, #d97757) center / 0.16em 100% no-repeat,
      linear-gradient(#d97757, #d97757) center / 100% 0.16em no-repeat;
  }
  [data-terminal] .spark::after {
    content: "";
    position: absolute;
    inset: 0;
    background: inherit;
    transform: rotate(45deg);
  }
  [data-terminal] .elbow {
    display: inline-block;
    width: 1.1em;
    height: 0.6em;
    margin: 0 0.9em 0 0.3em;
    vertical-align: 0.3em;
    border-left: 1.5px solid var(--color-faint);
    border-bottom: 1.5px solid var(--color-faint);
  }
  [data-terminal] .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    vertical-align: -0.2em;
    background: var(--color-ink-soft);
    animation: blink 1.1s steps(1) infinite;
  }
  [data-terminal] .account-chip.is-switching {
    animation: chip 0.42s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  /* Draws the eye to the first command until someone runs one. */
  [data-terminal]:not(.has-run) .first-run {
    animation: nudge 2.2s cubic-bezier(0.2, 0.8, 0.2, 1) infinite;
  }
  @keyframes nudge {
    0% {
      box-shadow: 0 0 0 0 rgb(255 255 255 / 0.22);
    }
    70%,
    100% {
      box-shadow: 0 0 0 10px rgb(255 255 255 / 0);
    }
  }
  @keyframes line-in {
    from {
      opacity: 0;
      transform: translateY(3px);
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes chip {
    40% {
      transform: scale(1.08);
      border-color: var(--color-active);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    [data-terminal] .line,
    [data-terminal] .account-chip.is-switching,
    [data-terminal] .cursor,
    [data-terminal]:not(.has-run) .first-run {
      animation: none;
    }
  }
</style>

<script>
  type Mode = "claude" | "codex" | "shell";
  type Step =
    | { html: string; className?: string; wait?: number }
    | { table: string[]; wait?: number }
    | { account: string; agent: string; wait?: number }
    | { open: Mode; wait?: number };

  const muted = (text: string) => `<span class="text-muted">${text}</span>`;
  const faint = (text: string) => `<span class="text-faint">${text}</span>`;
  const PROMPT = "Add rate limiting to the upload API";
  const CWD = "/Users/alex/code/upload-service";

  // Claude Code's screen, piece by piece.
  const welcome: Step = { html: `<span class="spark" aria-hidden="true"></span>Welcome to <b>Claude Code</b>!<br>${muted(`cwd: ${CWD}`)}`, className: "cc-box", wait: 220 };
  const user = (text: string, dim = false): Step => ({ html: `${muted(">")} ${text}`, className: dim ? "cc-user dim" : "cc-user", wait: 90 });
  const say = (text: string): Step => ({ html: `<span class="text-ink">⏺</span> ${text}`, wait: 380 });
  const tool = (name: string, arg: string, dim = false): Step => ({
    html: `${muted("⏺")} <b class="text-ink">${name}</b><span class="text-ink-soft">(${arg})</span>`,
    className: dim ? "dim" : undefined,
    wait: dim ? 60 : 320,
  });
  const result = (text: string): Step => ({ html: `<span class="elbow" aria-hidden="true"></span>${text}`, className: "result", wait: 260 });
  // A handova prompt line, in its rail.
  const ask = (question: string, answer: string, note = ""): Step => ({
    html: `${faint("◇")}  ${question}${note ? ` ${muted(note)}` : ""}  ${muted(answer)}`,
    wait: 520,
  });

  const scripts: Record<string, { command: string; steps: Step[] }> = {
    handoff: {
      command: "handova handoff primary backup",
      steps: [
        ask(`The conversation and memory will go to "backup"`, "Yes", "(Lumen Studio)."),
        { html: `◆  Session "${PROMPT}" copied, with 3 memory files.`, wait: 260 },
        { html: `${muted("●")}  This is a copy. What you do on "backup" won't appear on "primary".`, wait: 260 },
        { html: `${muted("●")}  Resuming on "backup"…`, wait: 520 },
        { account: "backup", agent: "Claude Code" },
        { open: "claude", wait: 160 },
        welcome,
        user(PROMPT, true),
        tool("Update", "src/upload/handler.ts", true),
        tool("Bash", "npm test", true),
        say("Picking up where we left off. Running the tests again."),
        tool("Bash", "npm test"),
        result(`<span class="text-ink-soft">14 passed (1.9s)</span>`),
      ],
    },
    codex: {
      command: "handova handoff codex codex-backup",
      steps: [
        ask(`The conversation will go to "codex-backup"`, "Yes", "(ChatGPT plus)."),
        { html: `◆  Session "Fix the flaky upload test" copied.`, wait: 260 },
        { html: `${muted("●")}  Codex keeps memory per account, so only the conversation moved.`, wait: 520 },
        { account: "codex-backup", agent: "Codex" },
        { open: "codex", wait: 160 },
        { html: `${muted(">_")} <b>OpenAI Codex</b> ${muted("(v0.162.1)")}<br>${muted(`directory: ${CWD}`)}`, className: "cc-box codex", wait: 220 },
        { html: `${muted("›")} Fix the flaky upload test`, className: "cc-user", wait: 240 },
        { html: `<span class="text-ink">•</span> Picking up where we left off: the retry in handler.test.ts.`, wait: 200 },
      ],
    },
    list: {
      command: "handova list",
      steps: [
        {
          table: [
            muted("ACCOUNT            AGENT        EMAIL              ORGANIZATION"),
            "primary (primary)  Claude Code  alex@mail.com      Personal",
            "backup             Claude Code  alex@lumen.studio  Lumen Studio",
            "codex (primary)    Codex        alex@mail.com      ChatGPT plus",
            "codex-backup       Codex        alex@lumen.studio  ChatGPT pro",
          ],
        },
      ],
    },
    continue: {
      command: "handova backup --continue",
      steps: [
        { account: "backup", agent: "Claude Code", wait: 200 },
        { open: "claude", wait: 160 },
        welcome,
        user(PROMPT, true),
        tool("Update", "src/upload/handler.ts", true),
        tool("Bash", "npm test", true),
        say("Rate limiting is in place and the tests pass. Anything else?"),
      ],
    },
    primary: {
      command: "handova primary",
      steps: [
        { account: "primary", agent: "Claude Code", wait: 200 },
        { open: "claude", wait: 160 },
        welcome,
        user(PROMPT, true),
        tool("Bash", "npm test", true),
        result(`<b class="text-[#f28b82]">Claude usage limit reached. Your limit will reset at 4pm.</b>`),
      ],
    },
  };

  const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLElement>("[data-terminal]").forEach((root) => {
    const output = root.querySelector<HTMLElement>("[data-output]")!;
    const input = root.querySelector<HTMLElement>("[data-input]")!;
    const inputPrefix = root.querySelector<HTMLElement>("[data-input-prefix]")!;
    const activeLabel = root.querySelector<HTMLElement>("[data-active]")!;
    const agentLabel = root.querySelector<HTMLElement>("[data-agent]")!;
    const chip = activeLabel.closest<HTMLElement>(".account-chip")!;
    let mode: Mode = "claude";
    const startHtml = output.innerHTML;
    const hint = root.querySelector<HTMLElement>("[data-hint]")!;
    const reset = root.querySelector<HTMLButtonElement>("[data-reset]")!;
    // Bumped on every click, so a newer run stops an older one mid-way.
    let run = 0;

    const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, reduceMotion.matches ? 0 : ms));
    const scrollDown = () => output.scrollTo({ top: output.scrollHeight, behavior: reduceMotion.matches ? "auto" : "smooth" });

    // Switch what the terminal is running: an agent's full screen (with its input box) or the shell.
    const open = (next: Mode) => {
      mode = next;
      output.replaceChildren();
      input.hidden = next === "shell";
      inputPrefix.textContent = next === "codex" ? "›" : ">";
    };

    const add = (html: string, className = "") => {
      const el = document.createElement("div");
      el.className = `line ${className}`.trim();
      el.innerHTML = html;
      output.append(el);
      scrollDown();
      return el;
    };

    const switchAccount = (account: string, agent: string) => {
      activeLabel.textContent = account;
      agentLabel.textContent = agent;
      chip.classList.remove("is-switching");
      void chip.offsetWidth;
      chip.classList.add("is-switching");
    };

    async function play(id: string) {
      const mine = ++run;
      const { command, steps } = scripts[id];

      // handova runs in the shell, so leave the agent's screen first.
      if (mode !== "shell") {
        open("shell");
      } else {
        output.querySelector(".cursor")?.closest(".line")?.remove();
      }
      const line = add(`${faint("$")} <span data-typed></span><span class="cursor" aria-hidden="true"></span>`);
      const typed = line.querySelector<HTMLElement>("[data-typed]")!;

      for (const char of command) {
        typed.textContent += char;
        await sleep(24 + Math.random() * 28);
        if (mine !== run) return;
      }
      line.querySelector(".cursor")?.remove();
      await sleep(260);

      for (const step of steps) {
        if (mine !== run) return;
        if ("account" in step) switchAccount(step.account, step.agent);
        else if ("open" in step) open(step.open);
        else if ("table" in step) add(step.table.join("\n"), "term-table");
        else add(step.html, step.className);
        await sleep(step.wait ?? 140);
      }
      if (mine !== run) return;
      if (mode === "shell") add(`${faint("$")} <span class="cursor" aria-hidden="true"></span>`);
    }

    root.querySelectorAll<HTMLButtonElement>("[data-run]").forEach((button) => {
      button.addEventListener("click", () => {
        root.classList.add("has-run");
        hint.hidden = true;
        reset.classList.remove("hidden");
        play(button.dataset.run!);
      });
    });

    // Back to the session that just hit its limit, as the page first showed it.
    reset.addEventListener("click", () => {
      run++;
      mode = "claude";
      output.innerHTML = startHtml;
      input.hidden = false;
      inputPrefix.textContent = ">";
      activeLabel.textContent = "primary";
      agentLabel.textContent = "Claude Code";
      output.scrollTo({ top: 0 });
    });
  });
</script>
