---
import SectionHead from "./SectionHead.astro";
// Made in code with Remotion (the handova-video project). The cover is the title frame; the file loads on play.
---

<section id="video" class="mx-auto max-w-6xl px-4 pb-10 pt-6 sm:px-8">
  <SectionHead title="Watch the handover" muted="in one minute.">
    One task, one usage limit, two accounts. Watch Handova set up, hand the conversation over, and manage Codex too.
  </SectionHead>

  <div class="reveal relative mt-12 overflow-hidden rounded-3xl border border-line bg-surface shadow-[0_40px_120px_-40px_rgb(0_0_0/0.9)]" data-video>
    <video
      class="block aspect-video w-full bg-bg"
      src="/handova.mp4"
      poster="/video-cover.jpg"
      preload="none"
      playsinline
      aria-label="Handova demo: a Claude Code session hits its usage limit and is handed over to another account"
      data-player
    ></video>
    <button
      type="button"
      class="group absolute inset-0 flex items-end justify-center bg-gradient-to-t from-black/50 via-transparent to-transparent pb-[3%] transition-colors sm:pb-[6%]"
      aria-label="Play the one-minute demo with sound"
      data-play
    >
      <span class="press flex items-center gap-2 rounded-full bg-ink py-1.5 pl-2.5 pr-3.5 text-[0.78rem] font-medium sm:gap-3 sm:py-3 sm:pl-4 sm:pr-6 sm:text-[0.95rem] text-bg shadow-[0_20px_60px_-20px_rgb(0_0_0/0.9)] transition-transform group-hover:scale-[1.03]">
        <svg class="h-3.5 w-3.5 sm:h-5 sm:w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path d="M6.5 4.6v10.8a.8.8 0 0 0 1.2.7l8.6-5.4a.8.8 0 0 0 0-1.4L7.7 3.9a.8.8 0 0 0-1.2.7Z" /></svg>
        Play with sound
        <span class="hidden font-mono text-[0.78rem] opacity-60 sm:inline">1:00</span>
      </span>
    </button>
  </div>
</section>

<style>
  [data-play].is-hidden {
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s cubic-bezier(0.2, 0.8, 0.2, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-play].is-hidden {
      transition: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-video]").forEach((box) => {
    const video = box.querySelector<HTMLVideoElement>("[data-player]")!;
    const play = box.querySelector<HTMLButtonElement>("[data-play]")!;
    play.addEventListener("click", () => {
      play.classList.add("is-hidden");
      video.controls = true;
      video.play().catch(() => {
        // Playback refused (e.g. a power-saving mode): leave the controls so it can be started by hand.
      });
    });
    video.addEventListener("ended", () => {
      play.classList.remove("is-hidden");
      video.controls = false;
    });
  });
</script>
