---
import InstallCommand from "./InstallCommand.astro";
import Terminal from "./Terminal.astro";
import { version } from "../data/project";
---

<section class="relative mx-auto max-w-5xl px-4 pb-20 pt-16 sm:px-8 sm:pt-24">
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-[28rem] max-w-3xl bg-[radial-gradient(ellipse_at_top,rgb(255_255_255/0.07),transparent_65%)]" aria-hidden="true"></div>

  <div class="reveal mx-auto max-w-2xl text-center">
    <p class="mb-5 inline-flex items-center gap-2 rounded-[5px] border border-line px-2.5 py-1 font-mono text-[0.72rem] text-muted">
      v{version} · free and open source
    </p>
    <h1 class="text-[clamp(1.9rem,9vw,2.5rem)] font-semibold leading-[1.05] tracking-[-0.04em] sm:text-[3.6rem]">
      Hit your limit.<br />Hand it over.
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-[1.05rem] leading-relaxed text-ink-soft sm:text-[1.15rem]">
      Handova runs your AI coding agent under as many accounts as you have. When one runs out, it hands the
      conversation to another in one command.
    </p>
    <div class="mx-auto mt-8 flex max-w-sm flex-col items-center">
      <div class="w-full [&_[role=group]]:mx-auto">
        <InstallCommand />
      </div>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-2 text-[0.78rem]">
        <span class="text-faint">Works with</span>
        <span class="rounded-[5px] border border-line-strong bg-raised px-2 py-0.5 font-medium text-ink">Claude Code</span>
        <span class="rounded-[5px] border border-dashed border-line px-2 py-0.5 text-muted">Codex · planned</span>
      </div>
    </div>
  </div>

  <div id="demo" class="reveal mx-auto mt-14 max-w-3xl">
    <Terminal />
  </div>
</section>
