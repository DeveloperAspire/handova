---
import Button from "./Button.astro";
import InstallCommand from "./InstallCommand.astro";
import Terminal from "./Terminal.astro";
import { repo, version } from "../data/project";
---

<section class="relative mx-auto max-w-6xl px-4 pb-24 pt-16 sm:px-8 sm:pt-28">
  <div class="pointer-events-none absolute inset-x-0 top-0 -z-10 mx-auto h-[32rem] max-w-4xl bg-[radial-gradient(ellipse_at_top,rgb(255_255_255/0.08),transparent_65%)]" aria-hidden="true"></div>

  <div class="reveal mx-auto max-w-3xl text-center">
    <a href="/docs#agents" class="group mb-7 inline-flex items-center gap-2 rounded-full border border-line bg-surface py-1 pl-1 pr-3 text-[0.8rem] text-ink-soft transition-colors hover:border-line-strong hover:text-ink">
      <span class="rounded-full bg-ink px-2 py-0.5 text-[0.7rem] font-medium text-bg">Works with</span>
      Claude Code and Codex
      <span class="text-faint transition-transform group-hover:translate-x-0.5" aria-hidden="true">→</span>
    </a>
    <h1 class="text-[clamp(1.7rem,8.4vw,3rem)] font-semibold leading-[0.98] tracking-[-0.05em] sm:text-[3.6rem] md:text-[4.3rem] lg:text-[4.8rem]">
      Hit your usage limit.<br /><span class="text-muted">Hand it over.</span>
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-[1.05rem] leading-relaxed text-ink-soft sm:text-[1.2rem]">
      Handova runs and manages your AI coding agent across as many accounts as you have. When one runs out, it
      hands the conversation to another in one command.
    </p>

    <div class="mx-auto mt-9 flex max-w-sm flex-col items-center">
      <div class="w-full [&_[role=group]]:mx-auto">
        <InstallCommand />
      </div>
      <p class="mt-3 text-[0.85rem] text-muted">
        Then run <code class="rounded-[5px] border border-line bg-surface px-1.5 py-0.5 font-mono text-[0.8rem] text-ink">handova setup</code>{" "}
        and it walks you through the rest.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-2.5">
        <Button href="/docs">
          Read the docs
          <span aria-hidden="true">→</span>
        </Button>
        <Button href={repo} variant="secondary">GitHub</Button>
      </div>
    </div>
    <p class="mt-6 font-mono text-[0.72rem] text-faint">v{version} · free and open source · MIT</p>
  </div>

  <div id="demo" class="reveal mx-auto mt-16 max-w-3xl">
    <Terminal />
  </div>
</section>
