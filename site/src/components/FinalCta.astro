---
import Button from "./Button.astro";
import CopyCommand from "./CopyCommand.astro";
import InstallCommand from "./InstallCommand.astro";
import { repo } from "../data/project";
---

<section class="mx-auto max-w-6xl px-4 pb-28 sm:px-8">
  <div class="reveal relative overflow-hidden rounded-3xl border border-line bg-surface px-6 py-16 text-center sm:px-12 sm:py-20">
    <div class="pointer-events-none absolute inset-x-0 top-0 mx-auto h-64 max-w-2xl bg-[radial-gradient(ellipse_at_top,rgb(255_255_255/0.07),transparent_70%)]" aria-hidden="true"></div>
    <h2 class="relative text-[2.15rem] font-semibold leading-[1.02] tracking-[-0.045em] sm:text-[3rem]">
      Keep working<br /><span class="text-muted">when the limit hits.</span>
    </h2>
    <p class="relative mt-5 text-ink-soft">Install it, then let setup walk you through your accounts.</p>
    <div class="relative mx-auto mt-8 max-w-sm space-y-2.5 text-left">
      <InstallCommand />
      <CopyCommand command="handova setup" label="Copy setup command" />
    </div>
    <div class="relative mt-8 flex flex-wrap justify-center gap-2.5">
      <Button href="/docs">Read the docs <span aria-hidden="true">→</span></Button>
      <Button href={repo} variant="secondary">Source on GitHub</Button>
    </div>
  </div>
</section>
