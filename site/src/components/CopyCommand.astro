---
// A terminal command with a Copy button.
interface Props {
  command: string;
  label?: string;
}
const { command, label = "Copy command" } = Astro.props;
---

<div class="flex items-center gap-2 rounded-[10px] text-left border border-line-strong bg-surface py-1.5 pl-3.5 pr-1.5" data-copy-command>
  <span class="select-none font-mono text-[0.85rem] text-faint" aria-hidden="true">$</span>
  <code class="min-w-0 flex-1 overflow-x-auto whitespace-nowrap font-mono text-[0.85rem] text-ink [scrollbar-width:none]" data-command>{command}</code>
  <button
    type="button"
    class="press flex h-8 shrink-0 items-center gap-1.5 rounded-[6px] bg-white/[0.07] px-2.5 text-[0.75rem] font-medium text-ink-soft hover:bg-white/[0.12] hover:text-ink"
    aria-label={label}
    data-copy
  >
    <svg class="h-3.5 w-3.5" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <rect x="5" y="5" width="9" height="9" rx="2" /><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5" />
    </svg>
    <span data-copy-label>Copy</span>
  </button>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-copy-command]").forEach((box) => {
    const button = box.querySelector<HTMLButtonElement>("[data-copy]")!;
    const label = box.querySelector<HTMLElement>("[data-copy-label]")!;
    const code = box.querySelector<HTMLElement>("[data-command]")!;
    let timer: number | undefined;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        label.textContent = "Copied";
      } catch {
        // No clipboard access: select the text so it can be copied by hand.
        getSelection()?.selectAllChildren(code);
        label.textContent = "Press ⌘C";
      }
      clearTimeout(timer);
      timer = window.setTimeout(() => (label.textContent = "Copy"), 1800);
    });
  });
</script>
