---
import SectionHead from "./SectionHead.astro";

const features = [
  {
    title: "Every account stays signed in",
    body: "No logging out and back in. Switch to any account with one word, or run several side by side in different terminals. Logging in or out of one never touches another.",
    code: "handova backup",
  },
  {
    title: "Hand over the conversation and its memory",
    body: "When one account hits its limit, Handova moves the conversation, and for Claude Code that folder's memory, to another account of the same agent, then opens it there so you carry on.",
    code: "handova handoff primary backup",
  },
  {
    title: "Each account stays clean",
    body: "Every account has its own conversations, memory and settings, so one organization's work never piles up with another's. A handover adds only what you choose, and never overwrites anything.",
    code: "handova handoff primary backup --pick",
  },
  {
    title: "Your instructions follow you",
    body: "New accounts share your instructions with your primary login: CLAUDE.md, skills, agents and commands for Claude Code; AGENTS.md, prompts and skills for Codex. Settings are copied, so each account can have its own.",
    code: "handova add backup",
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-28 sm:px-8">
  <SectionHead title="Switch and hand off," muted="without logging out.">
    Every account keeps its own login and its own history, your instructions follow you, and a conversation moves to another account in
    one command.
  </SectionHead>
  <div class="mt-14 grid gap-4 sm:grid-cols-2">
    {features.map((feature) => (
      <div class="reveal flex flex-col rounded-2xl border border-line bg-surface p-6 sm:p-8">
        <h3 class="text-[1.1rem] font-semibold tracking-[-0.01em]">{feature.title}</h3>
        <p class="mt-2.5 flex-1 leading-relaxed text-ink-soft">{feature.body}</p>
        <code class="mt-6 self-start rounded-[5px] border border-line bg-bg px-2.5 py-1 font-mono text-[0.78rem] text-ink-soft">
          {feature.code}
        </code>
      </div>
    ))}
  </div>
</section>
