---
import SectionHead from "./SectionHead.astro";

const features = [
  {
    title: "Every account stays signed in",
    body: "Each account gets its own folder and login for your coding agent. Logging in or out of one never touches another, and you can run them side by side in different terminals.",
    code: "handova backup",
  },
  {
    title: "Hand off in one command",
    body: "When one account hits its limit, Handova copies the conversation to another account of the same agent (Claude Code to Claude Code, Codex to Codex) and opens it there so you carry on.",
    code: "handova handoff primary backup",
  },
  {
    title: "Nothing gets overwritten",
    body: "Memory that already exists on the receiving account is kept. A conversation that was continued on both copies is left alone, and Handova tells you where to resume it.",
    code: "handova handoff primary backup --pick",
  },
  {
    title: "Your instructions follow you",
    body: "New accounts share your instructions with your primary login: CLAUDE.md, skills, agents and commands for Claude Code; AGENTS.md, prompts and skills for Codex. Settings are copied, so each account can have its own.",
    code: "handova add backup",
  },
];
---

<section class="mx-auto max-w-6xl px-4 py-28 sm:px-8">
  <SectionHead title="Switch accounts" muted="without losing your place.">
    Every account keeps its own login, your instructions follow you, and a conversation can move to another account in
    one command.
  </SectionHead>
  <div class="mt-14 grid gap-4 sm:grid-cols-2">
    {features.map((feature) => (
      <div class="reveal flex flex-col rounded-2xl border border-line bg-surface p-6 sm:p-8">
        <h3 class="text-[1.1rem] font-semibold tracking-[-0.01em]">{feature.title}</h3>
        <p class="mt-2.5 flex-1 leading-relaxed text-ink-soft">{feature.body}</p>
        <code class="mt-6 self-start rounded-[5px] border border-line bg-bg px-2.5 py-1 font-mono text-[0.78rem] text-ink-soft">
          {feature.code}
        </code>
      </div>
    ))}
  </div>
</section>
