---
import { repo } from "../data/project";
---

<header class="sticky top-0 z-20 border-b border-line bg-bg/75 backdrop-blur-md">
  <nav class="mx-auto flex h-14 max-w-6xl items-center justify-between px-4 sm:px-8">
    <a href="/" class="flex items-center gap-2 text-[1rem] font-semibold tracking-[-0.01em]">
      <img src="/favicon.svg" alt="" width="22" height="22" />
      Handova
    </a>
    <div class="flex items-center gap-1 text-[0.85rem] text-ink-soft sm:gap-2">
      <a href="/docs" class:list={["rounded-md px-2.5 py-1.5 transition-colors hover:text-ink", Astro.url.pathname.startsWith("/docs") && "text-ink"]}>Docs</a>
      <a href="/#handoff" class="hidden rounded-md px-2.5 py-1.5 transition-colors hover:text-ink sm:block">Handoff</a>
      <a href="/#faq" class="hidden rounded-md px-2.5 py-1.5 transition-colors hover:text-ink sm:block">FAQ</a>
      <a href={repo} class="press ml-1 flex items-center gap-1.5 rounded-full bg-ink px-3.5 py-1.5 font-medium text-bg hover:bg-white">
        <svg class="h-4 w-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
        GitHub
      </a>
    </div>
  </nav>
</header>
