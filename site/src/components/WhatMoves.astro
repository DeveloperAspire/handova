---
import SectionHead from "./SectionHead.astro";

// How a handoff works: the one rule, the three routes (with what each copies), the steps, what's already shared,
// and what never moves.
// Keep in sync with the "Hand a conversation to another account" section of the README.
const routes = [
  {
    from: "Claude Code",
    to: "Claude Code",
    supported: true,
    command: "handova handoff personal work",
    moves: [
      "The whole conversation: your messages, Claude's replies, and every tool call and its result",
      "Files saved alongside it, like subagent transcripts and long tool output",
      "Claude Code's memory for that folder: MEMORY.md and its files, merged without overwriting",
    ],
  },
  {
    from: "Codex",
    to: "Codex",
    supported: true,
    command: "handova handoff codex codex-work",
    moves: ["The whole conversation: your messages, Codex's replies, and every tool call and its result"],
    note: "Codex keeps its memory per account, not per folder, so memory stays where it is.",
  },
  {
    from: "Claude Code",
    to: "Codex",
    supported: false,
    command: "handova handoff personal codex",
    note: "The two agents save conversations in different ways, so one can't open the other's. Handova stops and tells you before anything is copied.",
  },
];

const steps = [
  ["Run it where you were working", "Handoffs are per folder, so run it in the same folder you were using the agent in."],
  ["It finds the conversation", "Your latest conversation in that folder, or the one you choose with --pick."],
  ["It asks first", "It names the account and organization the conversation is going to, and waits for a yes."],
  ["It copies, never overwrites", "Anything already on the other account is kept. Handing over again only brings an older copy up to date."],
  ["It opens it there", "The agent starts on the other account with the conversation loaded, and you carry on."],
];

// Already on every account, so a handoff doesn't need to copy it.
const shared = [
  "Your instructions: CLAUDE.md for Claude Code, AGENTS.md for Codex",
  "Your skills, plus agents and commands for Claude Code, and prompts for Codex",
  "Your code, because every account works in the same folder on the same computer",
];

const stays = [
  "Anything you do after the handoff. The copy is its own fork.",
  "The undo history for file edits, so rewind can't reach before the handoff",
  "Your other conversations, unless you hand them over too",
  "Logins and settings: each account keeps its own",
  "Claude Code's saved plan files (the conversation where a plan was made does move)",
  "Codex's memory, which belongs to the whole account",
];
---

<section id="handoff" class="mx-auto max-w-6xl px-4 py-28 sm:px-8">
  <SectionHead eyebrow="How a handoff works" title="Same agent," muted="different account.">
    A handoff moves a conversation from one of your accounts to another account of the same coding agent: Claude Code to
    Claude Code, or Codex to Codex. Use it when one account hits its usage limit and you want to keep going.
  </SectionHead>

  <div class="mt-14 grid gap-4 md:grid-cols-3">
    {routes.map((route) => (
      <div class:list={["reveal flex flex-col rounded-2xl p-6", route.supported ? "border border-line bg-surface" : "border border-dashed border-line"]}>
        <div class="flex items-center justify-between gap-3">
          <p class:list={["flex flex-wrap items-center gap-x-2 text-[1.02rem] font-semibold tracking-[-0.01em]", !route.supported && "text-ink-soft"]}>
            <span>{route.from}</span>
            <span class="text-faint" aria-label="to">→</span>
            <span>{route.to}</span>
          </p>
          <span
            class:list={[
              "shrink-0 rounded-[5px] border px-2 py-0.5 text-[0.72rem]",
              route.supported ? "border-line-strong bg-raised text-ink" : "border-dashed border-line text-muted",
            ]}
          >
            {route.supported ? "Works" : "Not yet"}
          </span>
        </div>
        <code class:list={["mt-4 self-start rounded-[5px] border border-line px-2 py-1 font-mono text-[0.74rem]", route.supported ? "bg-bg text-ink-soft" : "text-faint line-through decoration-faint"]}>
          {route.command}
        </code>
        {route.moves && (
          <ul class="mt-5 space-y-2.5">
            {route.moves.map((item) => (
              <li class="flex gap-2.5 text-[0.92rem] leading-relaxed text-ink-soft">
                <svg class="mt-1.5 h-3.5 w-3.5 shrink-0 text-ink" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 8.5l3.2 3L13 4.5" /></svg>
                {item}
              </li>
            ))}
          </ul>
        )}
        {route.note && <p class="mt-4 text-[0.88rem] leading-relaxed text-muted">{route.note}</p>}
      </div>
    ))}
  </div>

  <div class="reveal mt-14">
    <h3 class="font-mono text-[0.75rem] uppercase tracking-[0.12em] text-muted">What happens when you run it</h3>
    <ol class="mt-6 grid gap-x-8 gap-y-6 sm:grid-cols-2 lg:grid-cols-5">
      {steps.map(([title, body], i) => (
        <li>
          <span class="flex h-6 w-6 items-center justify-center rounded-[5px] border border-line-strong font-mono text-[0.72rem] text-ink">{i + 1}</span>
          <p class="mt-3 font-medium">{title}</p>
          <p class="mt-1.5 text-[0.9rem] leading-relaxed text-muted">{body}</p>
        </li>
      ))}
    </ol>
  </div>

  <div class="mt-14 grid gap-4 md:grid-cols-2">
    <div class="reveal rounded-2xl border border-line bg-surface p-6 sm:p-8">
      <h3 class="font-mono text-[0.75rem] uppercase tracking-[0.12em] text-ink">Already shared</h3>
      <p class="mt-3 text-[0.9rem] leading-relaxed text-muted">
        Linked to your primary login when you add an account, so the other account has them before any handoff.
      </p>
      <ul class="mt-5 space-y-2.5">
        {shared.map((item) => (
          <li class="flex gap-2.5 text-[0.92rem] leading-relaxed text-ink-soft">
            <svg class="mt-1.5 h-3.5 w-3.5 shrink-0 text-ink" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.5 9.5l3-3M5 7.5 3.8 8.7a2.3 2.3 0 0 0 3.3 3.3L8.3 10.8M11 8.5l1.2-1.2a2.3 2.3 0 0 0-3.3-3.3L7.7 5.2" /></svg>
            {item}
          </li>
        ))}
      </ul>
      <p class="mt-5 text-[0.82rem] leading-relaxed text-faint">
        Not for accounts added with <code class="font-mono">--no-share</code>, or folders adopted with
        <code class="font-mono">--dir</code> that already had their own.
      </p>
    </div>
    <div class="reveal rounded-2xl border border-line p-6 sm:p-8">
      <h3 class="font-mono text-[0.75rem] uppercase tracking-[0.12em] text-muted">Never copied</h3>
      <ul class="mt-5 space-y-2.5">
        {stays.map((item) => (
          <li class="flex gap-2.5 text-[0.92rem] leading-relaxed text-muted">
            <svg class="mt-1.5 h-3.5 w-3.5 shrink-0" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 8h8" /></svg>
            {item}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <p class="reveal mt-6 max-w-3xl text-[0.92rem] leading-relaxed text-muted">
    Handing a conversation to another account means it's processed under that account's organization. Handova names the
    organization and asks before it copies. If your workplace doesn't allow moving work between accounts, don't.
  </p>
</section>
