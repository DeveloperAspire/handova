---
import SectionHead from "./SectionHead.astro";

const agents = [
  {
    name: "Claude Code",
    command: "claude",
    primary: "~/.claude",
    extra: "~/.claude-<name>",
    shared: "CLAUDE.md, skills, agents, commands",
    handoff: "Conversation and that folder's memory",
  },
  {
    name: "Codex",
    command: "codex",
    primary: "~/.codex",
    extra: "~/.codex-<name>",
    shared: "AGENTS.md, prompts, skills",
    handoff: "Conversation (memory stays per account)",
  },
];
---

<section id="agents" class="mx-auto max-w-6xl px-4 py-28 sm:px-8">
  <SectionHead title="Works with" muted="your agents.">
    Handova runs and manages the agents you already use, each account with its own login. Add accounts for Claude Code, Codex or both, and
    hand conversations between accounts of the same agent.
  </SectionHead>

  <div class="mt-14 grid gap-4 md:grid-cols-3">
    {agents.map((agent) => (
      <div class="reveal rounded-2xl border border-line bg-surface p-6">
        <div class="flex items-center justify-between">
          <h3 class="text-[1.15rem] font-semibold tracking-[-0.01em]">{agent.name}</h3>
          <code class="rounded-[5px] border border-line bg-bg px-2 py-0.5 font-mono text-[0.74rem] text-ink-soft">{agent.command}</code>
        </div>
        <dl class="mt-6 space-y-3.5 text-[0.88rem]">
          <div>
            <dt class="text-muted">Primary login</dt>
            <dd class="mt-0.5 font-mono text-[0.8rem] text-ink-soft">{agent.primary}</dd>
          </div>
          <div>
            <dt class="text-muted">Extra accounts</dt>
            <dd class="mt-0.5 font-mono text-[0.8rem] text-ink-soft">{agent.extra}</dd>
          </div>
          <div>
            <dt class="text-muted">Shared with new accounts</dt>
            <dd class="mt-0.5 text-ink-soft">{agent.shared}</dd>
          </div>
          <div>
            <dt class="text-muted">A handoff moves</dt>
            <dd class="mt-0.5 text-ink-soft">{agent.handoff}</dd>
          </div>
        </dl>
      </div>
    ))}
    <div class="reveal flex flex-col justify-between rounded-2xl border border-dashed border-line p-6">
      <div>
        <h3 class="text-[1.15rem] font-semibold tracking-[-0.01em] text-ink-soft">More agents</h3>
        <p class="mt-3 text-[0.9rem] leading-relaxed text-muted">
          Everything specific to an agent lives in one file, so more can be added. Each one is checked against a real
          install before it ships.
        </p>
      </div>
      <a href="/docs#adding-agents" class="mt-6 inline-flex items-center gap-1.5 text-[0.88rem] text-ink-soft transition-colors hover:text-ink">
        How agents are added <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
